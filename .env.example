# =============================================================================
# Voice-Enabled RAG System - Environment Configuration Template
# Copy this file to .env and fill in your actual API keys.
# DO NOT commit your .env file containing real keys to version control!
# =============================================================================

# --- API Keys ---
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_ai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- LLM Provider ---
# Options: "groq", "gemini", "anthropic", or "lmstudio"
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.1-flash-lite
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Embeddings (Multilingual Indic-capable) ---
# Options for EMBEDDING_PROVIDER: "local" (sentence-transformers / ONNX) or "lmstudio"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
USE_ONNX_EMBEDDING=true
LMSTUDIO_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b

# --- FAISS Vector Index ---
FAISS_INDEX_PATH=./data/processed/semantic/faiss.index
CHUNK_METADATA_PATH=./data/processed/semantic/chunks.jsonl
CORPUS_CENTROID_PATH=./data/processed/semantic/centroid.npy
FAISS_NPROBE=10

# --- Retrieval Strategy & Parameters ---
# Options: "semantic", "fixed", "sentence_window", "recursive"
DEFAULT_CHUNK_STRATEGY=semantic
TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
ENABLE_RERANKER=false

# --- Guardrails ---
# Options: "llm_judge" or "nli"
GROUNDING_MODE=llm_judge
OFF_TOPIC_THRESHOLD=0.0

# --- Logging & Server ---
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- Edge Security & Rate Limiting ---
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
