# =============================================================================
# Voice-Enabled RAG System - Environment Configuration Template
# Copy this file to .env and fill in your actual API keys.
# DO NOT commit your .env file containing real keys to version control!
# =============================================================================

# --- API Keys ---
SARVAM_API_KEY=your_sarvam_ai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- LLM Provider ---
# Options: "gemini", "anthropic", or "lmstudio"
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Embeddings (Multilingual Indic-capable) ---
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- FAISS Vector Index ---
FAISS_INDEX_PATH=./data/processed/semantic/faiss.index
CHUNK_METADATA_PATH=./data/processed/semantic/chunks.jsonl
CORPUS_CENTROID_PATH=./data/processed/semantic/centroid.npy

# --- Retrieval Strategy & Parameters ---
# Options: "semantic", "fixed", "sentence_window", "recursive"
DEFAULT_CHUNK_STRATEGY=semantic
TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
ENABLE_RERANKER=false

# --- Guardrails ---
# Options: "llm_judge" or "nli"
GROUNDING_MODE=llm_judge
OFF_TOPIC_THRESHOLD=0.0

# --- Logging & Server ---
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
